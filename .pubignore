# NOTE: .pubignore REPLACES .gitignore when packaging — it does not add to it.
# Everything .gitignore excluded has to be repeated here, or build output ends
# up inside the published archive.

.dart_tool/
build/
.packages
pubspec.lock

# The README's recordings are served from a CDN, so nothing lives here now.
# Kept so any future screenshots or recordings stay out of the archive.
doc/

# The example is worth publishing; its platform scaffolding and build output
# are not.
example/build/
example/.dart_tool/
example/android/
example/ios/
example/linux/
example/macos/
example/windows/
example/web/
example/.gradle/

.idea/
*.iml
*.log
